{
  "buildCommand": "PRISMA_CLIENT_ENGINE_TYPE=library npx prisma generate && nest build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "dist/**",
        "bundle": false
      }
    },
    {
      "src": "api/diagnostic.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "api/index.js" },
    { "source": "/_diag", "destination": "api/diagnostic.js" },
    { "source": "/_health", "destination": "api/health.js" }
  ]
}
