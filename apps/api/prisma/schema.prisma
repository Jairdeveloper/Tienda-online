generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tabla tecnica para health checks de conectividad DB (Fase 1)
model HealthProbe {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("health_probes")
}

/// Cuentas de usuario (email)
model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String?     @unique @db.VarChar(320)
  name         String?     @db.VarChar(255)
  phone        String?     @db.VarChar(50)
  passwordHash String?     @map("password_hash") @db.Text
  metadata     Json?       @db.JsonB
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)

  roles       UserRole[]
  sessions    Session[]
  addresses   Address[]
  carts       Cart[]
  orders      Order[]
  auditLogs   AuditLog[]
  notifications Notification[]
  favorites   Favorite[]
  reviews     Review[]

  @@map("users")
}

/// Roles de RBAC
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permisos granulares
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(150)
  description String? @db.Text

  roles RolePermission[]

  @@map("permissions")
}

/// Relacion N:N rol ↔ permiso
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Relacion N:N usuario ↔ rol
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Sesiones activas (webapp/token), refresh tokens
model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  sessionToken     String   @unique @map("session_token") @db.Text
  refreshTokenHash String?  @map("refresh_token_hash") @db.Text
  ip               String?  @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.Text
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Direcciones de envio del usuario
model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String?  @db.VarChar(100)
  street     String?  @db.Text
  city       String?  @db.VarChar(100)
  state      String?  @db.VarChar(100)
  country    String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(30)
  phone      String?  @db.VarChar(50)
  meta       Json?    @db.JsonB
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

/// Categorias de producto (arbol mediante parent_id)
model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(255)
  slug      String     @unique @db.VarChar(255)
  metadata  Json?      @db.JsonB
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  parent   Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]       @relation("CategoryHierarchy")
  products ProductCategory[]

  @@map("categories")
}

/// Productos del catalogo
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String?  @unique @db.VarChar(100)
  name        String   @db.VarChar(500)
  description String?  @db.Text
  attributes  Json?    @db.JsonB
  metadata    Json?    @db.JsonB
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  categories ProductCategory[]
  variants   ProductVariant[]
  favorites  Favorite[]
  reviews    Review[]

  @@index([name])
  @@map("products")
}

/// Relacion N:N producto ↔ categoria
model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

/// Variantes de producto (talla, color, etc.)
model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String   @unique @db.VarChar(150)
  price      Decimal  @db.Decimal(12, 2)
  listPrice  Decimal? @map("list_price") @db.Decimal(12, 2)
  attributes Json?    @db.JsonB
  barcode    String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// Control de stock por variante
model Inventory {
  id           String   @id @default(uuid()) @db.Uuid
  variantId    String   @unique @map("variant_id") @db.Uuid
  locationId   String?  @map("location_id") @db.Uuid
  quantity     Int      @default(0)
  reserved     Int      @default(0)
  safetyStock  Int      @default(0) @map("safety_stock")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

/// Carrito persistente por usuario o sesion
model Cart {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  sessionToken String?  @map("session_token") @db.Text
  status       String   @default("active") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// Items del carrito
model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int      @default(1)
  priceSnapshot Decimal? @map("price_snapshot") @db.Decimal(12, 2)
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("cart_items")
}

/// Pedidos
model Order {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  externalId       String?   @unique @map("external_id") @db.VarChar(200)
  status           String    @default("pending") @db.VarChar(50)
  total            Decimal   @default(0) @db.Decimal(12, 2)
  currency         String    @default("USD") @db.VarChar(10)
  shippingAddress  Json?     @map("shipping_address") @db.JsonB
  billingAddress   Json?     @map("billing_address") @db.JsonB
  paymentSnapshot  Json?     @map("payment_snapshot") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

/// Items del pedido
model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  variantId  String  @map("variant_id") @db.Uuid
  qty        Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)
  metadata   Json?   @db.JsonB

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

/// Pagos y estados
model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  provider          String?  @db.VarChar(100)
  providerPaymentId String?  @map("provider_payment_id") @db.VarChar(200)
  amount            Decimal? @db.Decimal(12, 2)
  currency          String?  @db.VarChar(10)
  status            String?  @db.VarChar(50)
  rawResponse       Json?    @map("raw_response") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, providerPaymentId], name: "payments_provider_pid_idx")
  @@map("payments")
}

/// Auditoria de cambios
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tableName String   @map("table_name") @db.VarChar(200)
  recordId  String?  @map("record_id") @db.Uuid
  action    String?  @db.VarChar(20)
  userId    String?  @map("user_id") @db.Uuid
  diff      Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([tableName, createdAt])
  @@map("audit_logs")
}

/// Notificaciones
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  channel   String?   @db.VarChar(50)
  payload   Json?     @db.JsonB
  status    String?   @db.VarChar(50)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

/// Favoritos de usuario
model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("favorites")
}

/// Resenas de productos
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  rating    Int?
  title     String?  @db.VarChar(255)
  body      String?  @db.Text
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("reviews")
}
