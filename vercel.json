{
  "framework": null,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "regions": ["iad1"],
  "github": {
    "silent": true
  }
}
