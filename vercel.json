{
  "installCommand": "cd apps/api && PRISMA_SKIP_POSTINSTALL_GENERATE=true npm ci --include=dev && PRISMA_CLIENT_ENGINE_TYPE=library npx prisma generate && node api/fix-prisma-config.js && cd ../../apps/web && npm ci --include=dev",
  "buildCommand": "rm -rf apps/api/dist && npm run build",
  "builds": [
    {
      "src": "apps/web/dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "apps/api/api/diagnostic.js",
      "use": "@vercel/node"
    },
    {
      "src": "apps/api/api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "apps/api/api/handler.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "apps/api/dist/**",
        "bundle": false
      }
    },
    {
      "src": "apps/api/api/test.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "apps/api/dist/**",
        "bundle": false
      }
    },
    {
      "src": "apps/api/api/debug.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "apps/api/dist/**",
        "bundle": false
      }
    }
  ],
  "rewrites": [
    {
      "source": "/_diag",
      "destination": "apps/api/api/diagnostic.js"
    },
    {
      "source": "/_test",
      "destination": "apps/api/api/test.js"
    },
    {
      "source": "/_health",
      "destination": "apps/api/api/health.js"
    },
    {
      "source": "/_debug",
      "destination": "apps/api/api/debug.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "apps/api/api/handler.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/apps/web/dist/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/apps/web/dist/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
