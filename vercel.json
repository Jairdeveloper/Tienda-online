{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "echo 'BUST_20260531_1' && npm run build",
  "builds": [
    {
      "src": "api/diagnostic.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**"],
        "esbuild": {
          "bundle": false
        }
      }
    }
  ],
  "routes": [
    {
      "src": "/_diag",
      "dest": "api/diagnostic.js"
    },
    {
      "src": "/_health",
      "dest": "api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
