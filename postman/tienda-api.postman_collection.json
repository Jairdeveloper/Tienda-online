          }
        },
        {
          "name": "POST Webhook Mock",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const body = JSON.stringify(request.data);",
                  "const crypto = require('crypto-js');",
                  "const sig = crypto.HmacSHA256(body, pm.collectionVariables.get('webhookSecret')).toString();",
                  "pm.request.headers.add({ key: 'x-webhook-signature', value: sig });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.completed\",\n  \"paymentId\": \"payment-uuid\",\n  \"providerPaymentId\": \"ext_123\",\n  \"status\": \"paid\",\n  \"amount\": 100.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/webhooks/mock", "host": ["{{baseUrl}}"], "path": ["payments", "webhooks", "mock"] }
          }
        }
