# =============================================================================
# @tienda/api — Variables de Entorno
# =============================================================================
# Copia este archivo a .env para desarrollo local.
# Los valores comentados bajo "# ── Production" son para Vercel/CI.
#
# Convencion:
#   [REQUERIDA] = la app falla sin esta variable
#   [PRODUCCION] = solo necesaria cuando NODE_ENV=production
# =============================================================================


# ── Local Development ──
# Estas variables se activan al copiar este archivo a .env

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
LOG_LEVEL=debug
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# JWT — [REQUERIDA]
JWT_SECRET=change_me_in_real_environments
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Redis — Local via ioredis (TCP). Dejar vacio para deshabilitar Redis.
REDIS_URL=redis://localhost:6380

# Base de datos — [REQUERIDA]
DATABASE_URL=postgresql://tienda:tienda_dev@localhost:5432/tienda_online?schema=public

# Bot — Microservicio Python de soporte
BOT_SERVICE_URL=http://localhost:8000
BOT_ENABLED=true

# Webhooks — Valor por defecto seguro para desarrollo
WEBHOOK_SECRET=dev-webhook-secret-change-in-production


# ── Docker Compose Infrastructure ──
# Variables para docker-compose.yml (NO las lee la app NestJS directamente).
# Son sobreescribibles desde .env. Los defaults en docker-compose.yml coinciden
# con los valores de DATABASE_URL arriba.
#
# POSTGRES_DB=tienda_online
# POSTGRES_USER=tienda
# POSTGRES_PASSWORD=tienda_dev
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# REDIS_HOST=localhost
# REDIS_PORT=6380


# ── Production (Vercel + Neon + Upstash) ──
# Configurar en: Vercel Dashboard → Project → Environment Variables
# O en GitHub Secrets para CI/CD.
#
# Neon:   https://console.neon.tech
# Upstash: https://console.upstash.com
#
# NODE_ENV=production
# PORT=3000
# API_PREFIX=api/v1
# CORS_ENABLED=true
# CORS_ORIGIN=https://<your-frontend-domain>
# LOG_LEVEL=error
# SWAGGER_ENABLED=false
# SWAGGER_PATH=docs
# JWT_SECRET=<random-string-min-8-chars>                   [REQUERIDA]
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=604800
# DATABASE_URL=<Neon pooled URL, port 5433>                [REQUERIDA]
# DATABASE_URL_DIRECT=<Neon direct URL, port 5432>         (CI: prisma migrate deploy)
# REDIS_URL=<Upstash REST URL>                             (vacio = sin Redis)
# UPSTASH_REDIS_TOKEN=<upstash-token>                      [PRODUCCION]
# WEBHOOK_SECRET=<random-string-min-16-chars>              [PRODUCCION]
